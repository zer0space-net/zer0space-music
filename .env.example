# zer0space Music — configuration template.
#
# THIS REPOSITORY IS PUBLIC. Placeholders only; never commit a real value.
# On the cluster the three secrets below come from Docker Swarm secrets, which
# config.py reads BEFORE these environment variables — so the env form exists
# only for local development.
#
# Copy to .env for a local run (.env is gitignored).

# --- Database ---------------------------------------------------------------
# The same PostgreSQL instance the dashboard uses (zs-state-01), but its own
# database, so a music schema change can never touch dashboard data.
# Create it once:  CREATE DATABASE zer0space_music OWNER dashboard;
DB_HOST=192.168.0.16
DB_PORT=5432
DB_NAME=zer0space_music
DB_USER=dashboard
# Swarm secret `db_password` wins over this. Same secret the dashboard uses.
DB_PASS=replace-me

# DATABASE_URL, if set, overrides every DB_* above.
#DATABASE_URL=postgresql://user:pass@host:5432/zer0space_music

# --- Identity ---------------------------------------------------------------
# The shared token the dashboard presents. This service publishes no ports and
# trusts the X-Zer0space-User header ONLY when this token is presented with it.
# MUST match MUSIC_SERVICE_TOKEN on the dashboard.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Swarm secret name: music_service_token
MUSIC_SERVICE_TOKEN=replace-me

# Leaving this unset makes the service trust the user header from ANY caller.
# That is a development-only mode and the boot log says so loudly.

# --- Stream tickets ---------------------------------------------------------
# Signs the short-lived ticket the player puts in <audio src>. Set it as a
# Swarm secret (music_stream_secret) so tickets survive a restart; unset means
# a fresh key is generated at boot and every open player has to re-request its
# stream URL after a redeploy.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MUSIC_STREAM_SECRET=replace-me

# How long a minted ticket stays valid (seconds). Six hours by default, which
# comfortably outlasts a listening session without outliving the underlying
# resolved URL by much.
#MUSIC_STREAM_TTL=21600

# --- Mount ------------------------------------------------------------------
# The public path prefix. The dashboard gateway sends X-Forwarded-Prefix on
# every request and that wins; this is the fallback for a direct run.
#MUSIC_BASE_PATH=/music

# Where audio bytes are fetched from by the browser. Empty = same origin as the
# API, i.e. through the Cloudflare tunnel (the configured default). Point this
# at a direct or Tailscale host to move media off the tunnel without moving the
# API with it. See docs/architecture.md, "Where the bytes go".
#MUSIC_MEDIA_BASE_URL=

# --- Scraper ----------------------------------------------------------------
# Resolving audio via yt-dlp. Turning this off leaves a browsable catalogue
# that can only play Deezer's 30-second previews.
#MUSIC_SCRAPER_ENABLED=true

# Concurrent extractions. Small on purpose: YouTube rate-limits per IP and a
# burst of parallel extractions is the fastest way to get this host throttled.
#MUSIC_SCRAPER_WORKERS=2
#MUSIC_SCRAPER_TIMEOUT=45

# How long a resolved URL is reused before re-resolving (seconds). YouTube's
# audio URLs last roughly six hours; four is a deliberate safety margin.
#MUSIC_SOURCE_TTL=14400

# Optional: a Netscape-format cookies.txt to lift age gates and reduce bot
# checks. Mount it read-only. NEVER commit one — it is a live credential for a
# Google account, and this repo is public.
#MUSIC_COOKIES_FILE=/run/secrets/music_cookies

# Optional upstream proxy for the scraper only (not Deezer, not the media
# relay), for when this host's IP gets rate-limited.
#MUSIC_SCRAPER_PROXY=

# Play Deezer's 30s preview when the scraper finds nothing, instead of failing
# the track outright.
#MUSIC_PREVIEW_FALLBACK=true

# --- Catalogue --------------------------------------------------------------
#MUSIC_DEEZER_API=https://api.deezer.com
#MUSIC_CATALOG_TTL=21600
#MUSIC_SEARCH_LIMIT=40

# --- Misc -------------------------------------------------------------------
#PORT=8000
#MUSIC_LOG_REQUESTS=false
